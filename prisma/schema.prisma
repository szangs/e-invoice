// E-Invoice — Datenbankschema (PostgreSQL, DP-Standard)
// Mandantenmodul gemäß modul_Mandantenfaehig.md (Kernumfang)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Rollen: zwei Sphären (§3) ──
enum Role {
  OPERATOR_ADMIN // Betreiber-Administrator (keinem Mandanten zugeordnet)
  TENANT_ADMIN   // Mandanten-Administrator
  EDITOR         // Fach-Bearbeiter
  AREA_MANAGER   // Bereichs-Verantwortlicher
  AUDITOR        // Prüfer/Auditor
  USER           // Endnutzer
}

enum InvoiceStatus {
  NEW      // Neu
  CHECKED  // Geprüft
  EXPORTED // Exportiert
  REJECTED // Abgelehnt
}

// ── Mandant (§2) ──
model Tenant {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  // Exakte, rechtsverbindliche Firmenbezeichnung (Stefan 2026-08-25) — z. B.
  // laut Handelsregister, ggf. abweichend vom kurzen "Anzeigename" oben
  // (name). Wird gegen den Rechnungsempfänger (buyerName) jeder
  // eingehenden E-Rechnung geprüft (siehe erechnung.ts/ERechnungView.tsx) —
  // Warnung bei Abweichung, z. B. bei einer versehentlich falsch adressierten
  // oder gefälschten Rechnung. Leer = keine Prüfung (Mandant hat es noch
  // nicht gepflegt).
  legalName        String?
  // Übergabe sperren bei Abweichung (Stefan 2026-08-25) — solange die
  // Abweichung nicht per "Passt trotzdem" akzeptiert wurde, verhindert das
  // den Wechsel in den Übergabekorb (manuell wie automatisch, siehe
  // lib/baskets.ts requestMove). Standard aus — reine Warnung bleibt das
  // bisherige, unveränderte Verhalten.
  buyerNameMismatchBlocksHandover Boolean @default(false)
  // Rollen-Rechte-Matrix (Stefan 2026-08-27, "so etwas wie die Korb-Rechte
  // müssen wir für die Rollen auch haben") — je Rolle, ob sie bestimmte grobe
  // Aktionen darf (KI-Erkennung nutzen, Korrektur anfordern, Pflichtangaben-
  // Prüfung ignorieren, Audit-Protokoll einsehen), siehe lib/roleActions.ts.
  // NICHT zu verwechseln mit den Korb-Rechten (welche Körbe/Rechnungen darf
  // ich sehen/bearbeiten) — diese Matrix regelt QUERSCHNITTLICHE Fähigkeiten,
  // unabhängig vom einzelnen Korb. Null/fehlender Eintrag je Rolle+Aktion =
  // Standardwert aus ROLE_ACTION_DEFAULTS (siehe dort) — nur echte
  // Admin-gesetzte Abweichungen werden hier gespeichert, damit bestehende
  // Mandanten beim Rollout nichts verlieren. Administrator/Betreiber haben
  // immer alle Aktionen, unabhängig vom Inhalt dieses Felds.
  roleActions      Json?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  street           String?
  zip              String?
  city             String?
  active           Boolean   @default(true)
  licenseExpiresAt DateTime? // leer = unbegrenzt
  licenseSerial    String?
  licensePlan      String?
  employeeCount    Int       @default(0)
  maxUsers         Int       @default(5)
  // Mandantenspezifische Schalter (§2/§8)
  aiAllowed        Boolean   @default(false)
  ipLoggingAllowed Boolean   @default(false)
  defaultLanguage  String    @default("de")
  // Erscheinungsbild (Stefan 2026-08-27, "mach mal noch eine Farbauswahl") —
  // eines der in globals.css definierten [data-theme]-Schemata, siehe
  // src/components/settings/COLOR_THEMES für die Auswahlliste. "marine" ist
  // das bisherige, unveränderte DP-Standardschema.
  colorTheme       String    @default("marine")
  backupEnabled    Boolean   @default(false)
  // Ende-zu-Ende-Verschlüsselung der Belege (Zero-Knowledge):
  // Der Datenschlüssel (DEK) wird IM BROWSER erzeugt und mit einem aus der
  // Kunden-Passphrase abgeleiteten Schlüssel (KEK) verpackt. Der Server kennt
  // weder Passphrase noch entpackten DEK — Belege sind für den Betreiber unlesbar.
  encryptionEnabled Boolean  @default(false)
  encSalt           String? // Salt der Schlüsselableitung (Base64)
  encWrappedDek     String? // verpackter Datenschlüssel (Base64: IV + Chiffrat)
  // E-Mail-Eingang: nur Absender dieser Domänen annehmen (kommagetrennt, leer = alle)
  mailAllowedDomains String?
  // E-Mail-Eingang per Microsoft Graph (Alternative zum SMTP-Empfänger, Variante A):
  // ein Postfach + Ordnerpfad wird regelmäßig abgefragt statt per SMTP-Weiterleitung —
  // kein MX-Eintrag nötig. WICHTIG: eigene Azure-App-Registrierung DES MANDANTEN nötig
  // (nicht die des Betreibers!) — Anwendungsberechtigungen gelten nur innerhalb des
  // eigenen Azure-AD-Tenants. Der Betreiber betreut i. d. R. viele voneinander unabhängige
  // fremde Firmen, kann also nicht mit seinen eigenen Zugangsdaten in deren Postfächer.
  mailInGraphEnabled     Boolean @default(false)
  mailInGraphMailbox     String? // z. B. rechnungen@mandant.de
  mailInGraphFolder      String? // Ordnerpfad, z. B. "Posteingang/Rechnungen" — leer = Posteingang
  mailInGraphTenantId    String? // Azure-AD-Tenant-ID DES MANDANTEN (eigene App-Registrierung)
  mailInGraphClientId    String?
  mailInGraphClientSecret String?
  // Optional: verarbeitete Mails automatisch in diesen Ordner verschieben (leer =
  // nichts verschieben, Postfach bleibt unverändert). Braucht "Mail.ReadWrite" statt
  // nur "Mail.Read" in der Azure-App-Registrierung.
  mailInGraphMoveToFolder String?
  // Fortschritts-Zeiger (Stefan 2026-08-26, Review-Fund "Graph-Poller kann
  // dauerhaft steckenbleiben"): ohne mailInGraphMoveToFolder blieb jede
  // verarbeitete Nachricht im Quellordner liegen — das feste "$top=25,
  // älteste zuerst"-Fenster (graphMailin.ts fetchRecentMessages) zeigte dann
  // dauerhaft dieselben, längst verarbeiteten 25 ältesten Nachrichten, sobald
  // der Ordner insgesamt mehr als 25 enthielt; neuere kamen nie mehr dran.
  // Merkt sich stattdessen das receivedDateTime der zuletzt gesehenen
  // Nachricht — der nächste Poll fragt nur noch Nachrichten NACH diesem
  // Zeitpunkt ab, unabhängig davon, ob/wohin verschoben wird.
  mailInGraphLastSeenAt   DateTime?
  // E-Mail-Eingang per POP3 (Stefan 2026-08-27, Review-Fund "unter Mail noch
  // eine Unterkategorie zur Auswahl des Email-Verfahrens — SMTP Input und
  // Office 365 API gibt es schon, jetzt fehlt noch POP und IMAP"): dritte
  // Alternative, klassischer Postfach-Abruf per POP3S (nur implizites TLS,
  // Standardport 995 — kein STARTTLS auf Port 110). Abgerufene Nachrichten
  // werden nach erfolgreicher Verarbeitung vom Server gelöscht (POP3-
  // typisch — das Protokoll kennt keine Ordner/Markierungen wie IMAP, siehe
  // lib/pop3Mailin.ts). Dublettenprüfung zusätzlich über die Message-ID
  // (MailIntake.sourceMessageId) als Sicherheitsnetz, falls das Löschen
  // selbst fehlschlägt. Genau wie bei Graph ist immer nur EIN Verfahren
  // gleichzeitig aktiv (siehe SettingsHub.tsx Auswahl "E-Mail-Verfahren").
  mailInPop3Enabled Boolean @default(false)
  mailInPop3Host    String?
  mailInPop3Port    Int     @default(995)
  mailInPop3Secure  Boolean @default(true)
  mailInPop3User    String?
  mailInPop3Pass    String?
  // E-Mail-Eingang per IMAP (Stefan 2026-08-27) — vierte Alternative: Postfach
  // + Ordner werden per IMAPS abgefragt (nur implizites TLS, Standardport
  // 993). Anders als POP3 werden Nachrichten NICHT gelöscht, sondern nach
  // Verarbeitung als gelesen markiert (SEARCH UNSEEN beim nächsten Poll
  // findet sie dann nicht erneut) und optional in einen Zielordner
  // verschoben — dieselbe Semantik wie beim Graph-Weg, siehe lib/imapMailin.ts.
  mailInImapEnabled      Boolean @default(false)
  mailInImapHost         String?
  mailInImapPort         Int     @default(993)
  mailInImapSecure       Boolean @default(true)
  mailInImapUser         String?
  mailInImapPass         String?
  mailInImapFolder       String? // leer = INBOX
  mailInImapMoveToFolder String?
  // Eigenes Poll-Intervall je Mandant (Stefan 2026-08-27, "bei Mailabholung
  // müssen wir die Pollrate einstellen können") — vorher galt für ALLE
  // Mandanten eines Abrufwegs zwingend dasselbe, vom Betreiber global
  // gesetzte Intervall (MAIL_IN_GRAPH_POLL_SECONDS etc., Systemeinstellungen).
  // Leer = weiterhin dieser globale Standard. Nur EIN Feld für alle drei
  // Abrufwege nötig, da laut "E-Mail-Verfahren"-Auswahl ohnehin immer nur
  // einer gleichzeitig aktiv ist. Die Poller-Prozesse (graphMailin.ts/
  // pop3Mailin.ts/imapMailin.ts) selbst ticken jetzt in einem festen, feinen
  // Grundtakt (30s) und entscheiden JE MANDANT anhand von
  // mailInLastPolledAt + diesem Intervall, ob ein Abruf schon fällig ist —
  // das manuelle "Jetzt abrufen" ignoriert diese Sperre bewusst (siehe
  // api/mailin/poll/route.ts).
  mailInPollSeconds  Int?
  mailInLastPolledAt DateTime?
  // Automatische Antwort bei Spam-Verdacht (Stefan 2026-08-25): schickt dem
  // Absender einer als NOT_INVOICE eingestuften Mail eine kurze automatische
  // Info, dass sie nicht als Rechnung erkannt wurde und er sich bei echtem
  // Rechnungsbezug direkt an den Empfänger wenden soll (siehe lib/mailin.ts
  // sendSpamNotice). Standardmäßig AUS wie alle anderen automatisierten
  // Mail-Trigger in der App — Restrisiken bewusst in Kauf genommen (auf
  // Wunsch aktiviert): Backscatter bei gefälschter Absenderadresse (kein
  // technischer Schutz möglich) und Bestätigung einer aktiven Mailbox
  // gegenüber Spam-Versendern. Je Empfänger nur einmal (Invoice.spamReplySentAt).
  // Greift NIE im Entwicklermodus (Stefan 2026-08-25) — dort laufen Test-/
  // Demo-Läufe, oft mit echten Absenderadressen (siehe lib/mailin.ts sendSpamNotice).
  spamReplyEnabled Boolean @default(false)
  // Automatisches Löschen bei 100%-sicher erkannten Dubletten (Stefan
  // 2026-08-25): NUR bei identischer Beleg-Datei (SHA-256-Hash-Treffer,
  // siehe lib/duplicates.ts hashBuffer) — der schwächere Abgleich über
  // Rechnungsnummer+Lieferant bleibt IMMER nur eine Markierung mit
  // Nachprüfung durch einen Menschen (Vier-Augen-relevant, keine
  // hundertprozentige Sicherheit). Betrifft nur den automatischen
  // Mail-Eingang (lib/mailin.ts) — beim manuellen Upload warnt die Oberfläche
  // stattdessen VOR dem Speichern (Dubletten-Bestätigung). Soft-Delete wie
  // beim regulären Löschen-Button, nichts wird endgültig entfernt.
  autoDeleteExactDuplicates Boolean @default(false)
  // Rechnungsversionierung (Stefan 2026-08-25) — EIGENES Konzept, KEINE
  // Dublette: derselbe Lieferant schickt dieselbe Rechnungsnummer mehrfach,
  // aber mit UNTERSCHIEDLICHEM Dateiinhalt (sonst wäre es eine Dublette,
  // siehe autoDeleteExactDuplicates oben) — z. B. eine korrigierte/erneut
  // gesendete Fassung. Bei aktivem Schalter wird automatisch die neueste
  // Version aktiv gehalten, ältere Versionen werden schreibgeschützt
  // ("ausgegraut", Invoice.supersededAt) statt als Dublette zur manuellen
  // Entscheidung markiert — nichts wird gelöscht, alle Versionen bleiben
  // nachvollziehbar sichtbar. Betrifft nur den automatischen Mail-Eingang.
  autoSupersedeInvoiceVersions Boolean @default(false)
  // Datensicherung (§17): Häufigkeit + Zustell-Adresse + letzte Sicherung
  backupFrequency String? // DAILY | WEEKLY | MONTHLY | YEARLY
  backupEmail     String?
  lastBackupAt    DateTime?
  // Sicherungs-Umstellung (Stefan 2026-07-08): die Sicherung wird nicht mehr
  // als E-Mail-Anhang verschickt, sondern als ZIP-Paket (Hash + alle
  // Belegdateien) serverseitig abgelegt — die E-Mail enthält nur noch einen
  // Download-Link (siehe BackupPackage). backupReminderDays steuert, wie
  // lange erinnert wird, solange das Paket noch nicht heruntergeladen wurde
  // (0/leer = keine Erinnerung).
  backupReminderDays Int? @default(14)
  // Optionales externes Sicherungsziel per WebDAV (z. B. Nextcloud/ownCloud;
  // "klassisches" WebDAV-fähiges OneDrive for Business/SharePoint geht
  // ebenfalls — das moderne OneDrive-Verbraucherprodukt bietet KEIN WebDAV
  // mehr an, siehe Hinweistext in der Mandanten-Einstellungs-UI). Passwort
  // hier bewusst einfach als Text abgelegt wie die übrigen Mandanten-
  // Einstellungen dieser App — für ein produktives Setup mit hohem
  // Schutzbedarf sollte das Feld zusätzlich verschlüsselt werden.
  backupWebdavUrl  String?
  backupWebdavUser String?
  backupWebdavPass String?
  backupPackages   BackupPackage[]
  // Revisionssicherer Hash-Bericht (Whitepaper-Preismodell Punkt 4): eigener,
  // schlanker Lauf — Rechnungsliste + Beleg-Hashes an eine feste Kunden-Adresse,
  // unabhängig von Sicherung/Restore. lastReportHash verkettet die Berichte
  // (wie die Audit-Hash-Kette, §18) für Fälschungssicherheit über die Zeit.
  reportEnabled   Boolean   @default(false)
  reportFrequency String? // DAILY | WEEKLY | MONTHLY | YEARLY
  reportEmail     String?
  lastReportAt    DateTime?
  lastReportHash  String?
  // DATEV-Export (Übergabekorb → Fibu, Stefan 2026-07-08): Beraternummer/
  // Mandantennummer/Kontenrahmen sind je Mandant unterschiedlich (eigener
  // Steuerberater), daher hier statt in den globalen Betreiber-Einstellungen.
  // Erster Entwurf mit einem Sammelkonto für alle Lieferanten (Stefans Wahl)
  // — die weitere Kontierung je Lieferant bleibt Aufgabe der Fibu in DATEV.
  datevBeraternr       String?
  datevMandantnr       String?
  // Stefan 2026-08-26 (Review-Fund): Default SKR04 für NEU angelegte
  // Mandanten, seit der DATEV-Export dieses Feld zwingend braucht (siehe
  // lib/datev.ts validateDatevSettings) — sonst würde ein frisch angelegter
  // Mandant beim allerersten Export ohne ersichtlichen Grund abgewiesen.
  // Bestandsmandanten mit NULL werden per Backfill-Skript nachgezogen.
  datevSkr             String? @default("SKR04") // SKR03 | SKR04 — nur Beschriftung/Doku, keine Kontenlogik
  datevSachkontenlaenge Int?    @default(4)
  datevKreditorenkonto String? // Sammelkonto für alle Kreditoren (Feld "Konto")
  datevGegenkonto      String? // Sammel-Gegenkonto (Feld "Gegenkonto", z. B. Wareneingang/Kosten)
  datevWjBeginn        String? // Wirtschaftsjahr-Beginn als TTMM, z. B. "0101"
  // Optional zusätzlich zum CSV-Sammel-Export: eine EINZELNE E-Mail je Beleg
  // an die Fibu, mit dem Original-Beleg (PDF/Bild) im Anhang — für den Fall,
  // dass die Fibu die Dokumente selbst sehen will/muss, nicht nur die
  // Buchungsdaten aus dem DATEV-CSV (Stefan 2026-07-08).
  datevFibuEmail       String?
  // Zahlungsverkehr (Stefan 2026-08-27, SEPA-Sammelüberweisung, Review-Fund
  // "welche Export-Module an Fibu noch wichtig wären") — Auftraggeberkonto
  // DES MANDANTEN (der Zahler) für den pain.001-Export, siehe lib/sepa.ts.
  // Getrennt von den Lieferanten-IBANs (VendorAddress.iban/bic).
  sepaOwnName String? // Kontoinhaber laut Bank — meist legalName, kann abweichen
  sepaOwnIban String?
  sepaOwnBic  String?
  // Kostenstellen/Kostenträger (Stefan 2026-07-09, #114): optionale, im
  // Mandanten-Stamm abschaltbare Buchungsdimension — genau wie bei den
  // Lieferanten-Konten oben wird eine Liste (Code+Bezeichnung) importiert,
  // aus der beim Bearbeiten einer Rechnung ausgewählt werden kann (siehe
  // CostCode/Invoice.costCenterCode/costCarrierCode). Bei "aus" bleibt die
  // Auswahl in der Rechnung ausgeblendet, bereits gesetzte Werte gehen dabei
  // nicht verloren. Stefan 2026-08-26: vorher EIN gemeinsamer Schalter für
  // beide — in der Praxis nutzt aber nicht jeder Mandant beides zusammen,
  // deshalb jetzt zwei unabhängige Schalter.
  costCenterEnabled  Boolean @default(false)
  costCarrierEnabled Boolean @default(false)
  costCodes          CostCode[]
  // Zähler für eindeutige Dokumenten-IDs (<Slug>-<laufende Nummer>, siehe
  // lib/docId.ts und Invoice.docId) — atomar hochgezählt, damit auch bei
  // gleichzeitigen Uploads keine Doppelvergabe entsteht.
  nextDocSeq       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[]
  invoices         Invoice[]
  apiTokens        ApiToken[]
  baskets          Basket[]
  vendorAccounts   VendorAccount[]
  vendorAddresses  VendorAddress[]
  employeeGroups   EmployeeGroup[]
  auditPeriodClosures AuditPeriodClosure[]
  invoiceSearchTokens InvoiceSearchToken[]
  scanSessions        ScanSession[]
}

// ── Optionale Verknüpfung vorhandener Fibu-Konten zu Lieferanten (Stefan
// 2026-07-08): per CSV-Import befüllbar (z. B. Export der Kreditoren-
// Stammdaten aus DATEV/der Fibu). Beim DATEV-Export wird für einen
// Lieferanten dieses Konto verwendet, wenn der Name übereinstimmt — sonst
// gilt weiterhin das Sammelkonto (Tenant.datevKreditorenkonto). Komplett
// optional, ohne Import bleibt alles beim Sammelkonto-Verhalten von v1.
model VendorAccount {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorName String // Abgleich mit Invoice.vendor, case-insensitiv/exakt
  konto      String // DATEV-Kontonummer für diesen Lieferanten
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, vendorName])
}

// Lieferanten-Adressregister (Stefan 2026-08-26): anders als VendorAccount
// oben (manuell per CSV gepflegte Fibu-Kontenzuordnung) wird diese Tabelle
// AUTOMATISCH bei jeder Rechnung mit lesbarer Anschrift aktualisiert (siehe
// lib/vendorMemory.ts upsertVendorAddress) — "immer die zuletzt übermittelte
// Anschrift je Lieferant", als Grundlage für einen eigenständigen Adress-
// Export an die Fibu (api/invoices/export/vendor-addresses). Nur die
// Anschrift, KEINE Rechnungsdaten — deshalb auch bei aktiver
// Inhalts-Verschlüsselung unproblematisch (der Server sieht die Anschrift
// dort ohnehin nie im Klartext, also wird hier auch nichts aktualisiert).
model VendorAddress {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorName String // Abgleich mit Invoice.vendor, case-insensitiv/exakt
  // Nullable seit 2026-08-27 (vorher Pflichtfeld) — ein Lieferant kann jetzt
  // auch NUR mit Bankverbindung angelegt sein (manuell für den SEPA-Export
  // erfasst, ohne dass je eine Rechnung mit lesbarer Anschrift kam).
  address    String?
  // Pflichtangaben-Schnellausfüllung (Stefan 2026-08-27, "Schnellausfüllung
  // bei den Anschriftdaten, wenn er den Lieferant schon kennt") — genau wie
  // address "zuletzt gesehen" je Lieferant, Grundlage für den Vorschlag auf
  // der Rechnungsdetailseite (siehe lib/vendorMemory.ts
  // getVendorAddressSuggestion, InvoiceEditForm.tsx). Wie address bei
  // aktiver Inhalts-Verschlüsselung unproblematisch — der Server sieht
  // diese Werte dort ohnehin nie im Klartext, die Spalten bleiben dann
  // einfach leer.
  vatId       String?
  taxNumber   String?
  countryCode String?
  updatedAt  DateTime @updatedAt
  // Zahlungsverkehr (Stefan 2026-08-27, SEPA-Sammelüberweisung, siehe
  // lib/sepa.ts): IBAN/BIC werden — falls im PaymentMeans-Block einer
  // E-Rechnung vorhanden — automatisch vorbefüllt (lib/vendorMemory.ts),
  // gelten aber erst als für einen Zahllauf nutzbar, wenn ein Mensch sie
  // bestätigt hat (ibanVerifiedAt gesetzt, in UserAdmin o.ä. Admin-Oberfläche
  // per Knopf). Ein einmal bestätigter Wert wird durch eine neue Rechnung
  // NICHT mehr automatisch überschrieben (siehe upsertVendorAddress) — sonst
  // könnte eine gefälschte/fehlerhafte Rechnung eine geprüfte Kontoverbindung
  // unbemerkt kapern.
  iban           String?
  bic            String?
  ibanVerifiedAt DateTime?
  ibanVerifiedBy String?

  @@unique([tenantId, vendorName])
}

// ── Kostenstellen/Kostenträger (Stefan 2026-07-09, #114) ── optionale,
// abschaltbare Buchungsdimension, genau wie VendorAccount per CSV-Import
// befüllbar (Code;Bezeichnung). Ein Code wird auf der Rechnung als einfacher
// STRING gespeichert (Invoice.costCenterCode/costCarrierCode), nicht als
// Fremdschlüssel — wird ein Code später aus dieser Liste gelöscht/umbenannt,
// bleibt der historische Buchungswert auf bereits zugeordneten Rechnungen
// unverändert (GoBD: einmal gebuchte Werte nicht rückwirkend verändern).
enum CostCodeKind {
  KOSTENSTELLE
  KOSTENTRAEGER
}

model CostCode {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      CostCodeKind
  code      String
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, kind, code])
  @@index([tenantId, kind])
}

// ── Sicherungspakete (Stefan 2026-07-08) ── ZIP-Datei einer Sicherung
// (Mandant oder Gesamtsystem), serverseitig abgelegt mit SHA-256-Prüfsumme.
// Die Zustell-E-Mail enthält nur den Download-Link (downloadToken) statt des
// Pakets selbst; runBackupReminders() erinnert, solange nicht heruntergeladen
// und innerhalb von tenant.backupReminderDays.
model BackupPackage {
  id             String    @id @default(cuid())
  tenantId       String? // null = System-Sicherung (alle Mandanten)
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind           String // TENANT | SYSTEM
  fileName       String // gespeicherter Dateiname unter backup-packages/{tenantId|system}/
  originalName   String // Downloadname für den Nutzer (…-<hash8>.zip)
  sha256         String
  sizeBytes      Int
  downloadToken  String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  downloadedAt   DateTime?
  lastReminderAt DateTime?
  reminderCount  Int       @default(0)
  // Ergebnis des optionalen zusätzlichen WebDAV-Uploads (Tenant.backupWebdavUrl)
  remoteStoredAt DateTime?
  remoteError    String?

  @@index([tenantId, createdAt])
  @@index([downloadedAt])
}

// ── API-Token für die Browser-Extension (Rechnungs-Catcher) ──
model ApiToken {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label      String
  tokenHash  String    @unique // SHA-256 des Tokens — Klartext wird nie gespeichert
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// ── Benutzer (§2) ──
model User {
  id              String    @id @default(cuid())
  tenantId        String? // null = Betreiber-Administrator
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String
  username        String    @unique // global eindeutiger technischer Name
  passwordHash    String
  // Stammdaten (Stefan 2026-07-08): für Mitarbeiter-Übersicht, Anrede in
  // Mails und Zuordnung in Körben — alle optional, da Bestandsnutzer sie
  // noch nicht haben.
  firstName       String?
  lastName        String?
  department      String? // Abteilung
  jobTitle        String? // Funktion
  role            Role      @default(USER)
  active          Boolean   @default(true)
  language        String    @default("de")
  twoFactorSecret String? // reserviert (MVP: 2FA nicht aktiv)
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  lastSeenAt      DateTime?
  forcedLogoutAt  DateTime? // Zwangsabmeldung-ab (§10)
  // KI-/Sicherungs-Hinweis beim Login (Stefan 2026-08-26): zählt echte
  // Passwort-Logins seit der letzten Bestätigung — ab 10 wird der Hinweis
  // (KI-Daten können fehlerhaft sein + regelmäßige Sicherung) erneut gezeigt,
  // siehe api/session/ai-notice/route.ts. Nur relevant bei Mandanten mit
  // aktivierter KI (Tenant.aiAllowed).
  aiNoticeLoginCount Int       @default(0)
  aiNoticeAckedAt    DateTime?
  invoices        Invoice[]
  basketMemberships BasketMember[]
  basketApprovals   BasketApproval[]
  basketRights      BasketUserRight[]
  // Mitarbeiter-Gruppen (Stefan 2026-08-26) — siehe EmployeeGroup unten.
  groupMemberships  EmployeeGroupMember[]
  uploadedAttachments   InvoiceAttachment[]
  notesAuthored         InvoiceNote[]       @relation("InvoiceNoteAuthor")
  notesReceived         InvoiceNote[]       @relation("InvoiceNoteRecipient")
  scanSessions          ScanSession[]

  // E-Mail ist PRO MANDANT eindeutig, nicht global (§2)
  @@unique([tenantId, email])
  @@index([email])
}

// ── Betreiber-Systemeinstellungen (§24), Schlüssel/Wert ──
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Tages-Schnappschuss des globalen KI-Verbrauchszählers (Stefan 2026-08-27,
// "Zeitraum beim KI-Verbrauch sollte über einen Monat gehen") — anders als
// CPU/RAM/Speicherplatz (siehe lib/metrics.ts, In-Prozess-Ringpuffer für
// 24 Stunden) muss ein Monatsverlauf einen Server-Neustart überstehen, ein
// In-Memory-Puffer reicht dafür nicht. Tages- statt Minutengranularität
// reicht für einen Monatstrend völlig aus und hält die Tabelle winzig
// (~30 Zeilen). Global, nicht mandantenbezogen — AI_TOKENS_TOTAL (siehe
// lib/settings.ts) ist ebenfalls ein globaler Zähler fürs Betreiber-Cockpit.
model MetricDailySnapshot {
  id            String   @id @default(cuid())
  date          DateTime @unique // Tagesgranularität (UTC-Mitternacht normalisiert)
  aiTokensTotal Int
  createdAt     DateTime @default(now())
}

// ── Revisionssichere Protokollierung mit Hash-Kette (§18) ──
model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  tenantId  String?
  actorId   String?
  actorName String
  action    String
  details   String?
  ip        String? // nur wenn Mandant zugestimmt hat (§18)
  prevHash  String
  hash      String

  @@index([tenantId, createdAt])
}

// Perioden-Abschluss des Audit-Protokolls (Stefan 2026-08-25): "sealt"
// jeweils ein Kalenderjahr — hält den letzten Eintrag/dessen Hash zum
// Abschlusszeitpunkt fest (die Verkettung in AuditLog macht diesen einen
// Hash bereits zu einem kryptografischen Nachweis über ALLE davorliegenden
// Einträge, siehe lib/audit.ts). Einmal abgeschlossen, UNVERÄNDERLICH — kein
// erneutes Abschließen desselben Jahres. closedByName ist die eingegebene
// "Unterschrift" (Klarname), die auf dem Zertifikat erscheint (siehe
// lib/auditCertificate.ts) — keine Bild-Signatur, ein getippter Name mit
// Zeitstempel, wie bei den übrigen Freigaben in der App (z. B. Vier-Augen-Prinzip).
// Perioden-Abschluss je MANDANT (Stefan 2026-08-27, Review-Fund "gehört zum
// Mandanten, nicht ins Betreiber-Cockpit" — vorher war das Jahr systemweit
// EIN Datensatz für ALLE Mandanten gleichzeitig, ausgelöst vom Betreiber statt
// vom jeweiligen Mandanten-Admin selbst). Die zugrunde liegende Hash-Kette
// (AuditLog, lib/audit.ts) bleibt bewusst EINE einzige, mandantenübergreifende
// Kette — das ist gerade die Stärke der Fälschungssicherheit (kein Mandant
// könnte seine eigene Historie unbemerkt umschreiben, ohne die gemeinsame
// Kette zu brechen). lastEntryId/chainHash referenzieren deshalb weiterhin
// den letzten Eintrag der GESAMTEN Kette bis Periodenende; entryCount/
// firstEntryId sind dagegen auf die Einträge DIESES Mandanten begrenzt (siehe
// api/audit/period-close/route.ts) — der Abschluss selbst und sein
// Sperreffekt (isInvoiceLockedByClosure) gelten nur für den jeweiligen
// Mandanten, ein Mandant kann unabhängig vom Rest sein eigenes Jahr schließen.
model AuditPeriodClosure {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year          Int
  closedAt      DateTime @default(now())
  closedByName  String
  closedByEmail String
  entryCount    Int
  firstEntryId  Int?
  lastEntryId   Int
  chainHash     String

  @@unique([tenantId, year])
}

// ── Fernwartung §14A: eingebaute Bildschirmspiegelung (ohne externe Software) ──
enum SupportStatus {
  REQUESTED // angefragt
  ACTIVE    // aktiv (Einwilligung erteilt)
  ENDED     // beendet
  DECLINED  // abgelehnt
}

model SupportSession {
  id          String        @id @default(cuid())
  tenantId    String
  userId      String? // Nutzer, dessen Sicht gespiegelt wird (bei Betreiber-Anfrage erst nach Einwilligung)
  initiatedBy String // 'TENANT' | 'OPERATOR'
  status      SupportStatus @default(REQUESTED)
  createdAt   DateTime      @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  endedBy     String?
  snapshot    String? // letzter DOM-Spiegel (maskiert, ohne Skripte)
  snapshotAt  DateTime?

  @@index([tenantId, status])
}

// ── E-Mail-Eingang (Weiterleitungs-Modell W1/W2): Protokoll aller Eingänge & Versuche ──
model MailIntake {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  tenantId    String? // null = keinem Mandanten zuordenbar (Fehlversuch)
  fromAddress String
  toAddress   String
  subject     String?
  status      String // PROCESSED | NO_ATTACHMENT | UNKNOWN_RECIPIENT | TENANT_LOCKED | ERROR
  detail      String?
  invoiceId   String?
  sourceMessageId String? // Graph-Nachrichten-ID (Dublettenprüfung beim Graph-Poller); SMTP: null

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([tenantId, sourceMessageId])
}

// ── Körbe (Rechnungseingangsverarbeitung, Stefan 2026-07-08): Rechnungen
// wandern durch benannte "Körbe" (wie E-Mail-Postfach-Ordner) statt einer
// einzigen flachen Liste. Jeder Mandant hat automatisch genau einen
// Eingangskorb (kind=INBOX, wo neu erfasste Rechnungen zuerst landen) und
// einen Übergabekorb (kind=HANDOVER, Endstation vor Export/Buchhaltung) —
// beide werden bei Bedarf automatisch angelegt (siehe lib/baskets.ts
// ensureSystemBaskets). Dazwischen beliebig viele frei anlegbare Körbe
// (kind=CUSTOM). Vier-Augen-Prinzip ist für INBOX/HANDOVER serverseitig
// gesperrt (dort macht ein zusätzliches Freigabe-Gate konzeptionell keinen
// Sinn — Eingang ist offen, Übergabe ist bereits das Ergebnis der Kette).
enum BasketKind {
  INBOX
  HANDOVER
  CUSTOM
  // Ablage (Stefan 2026-07-09): fester Systemordner, in den Rechnungen nach
  // vollständiger Übergabe automatisch wandern und dort bleiben. Nur
  // Mandanten-Admin/Betreiber dürfen Belege von dort wieder herausverschieben
  // — Korb-Rechte MOVE und höher lassen sich für ARCHIVE-Körbe gar nicht erst
  // vergeben (siehe admin/baskets/[id]/rights/route.ts).
  ARCHIVE
  // Spam-Verdacht (Stefan 2026-08-25): fester Systemordner für Mail-Eingang-
  // Dokumente, die die automatische Klassifikation (lib/mailin.ts) eindeutig
  // als KEINE Rechnung einstuft (Newsletter, Bewerbungs-Spam, Werbe-PDF …).
  // Der Beleg wird trotzdem angelegt (nichts geht bei einer Fehlklassifikation
  // verloren) — landet aber nicht im Eingangskorb und stört dort nicht. Ganz
  // normaler Korb (Rechte frei vergebbar, im Unterschied zu ARCHIVE), damit
  // eine fälschlich einsortierte echte Rechnung einfach per Drag&Drop
  // zurückgeholt werden kann.
  QUARANTINE
}

model Basket {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  kind      BasketKind @default(CUSTOM)
  position  Int        @default(0) // Reihenfolge in der Anzeige/Kette
  // Vier-Augen-Prinzip: EIGENES Gate beim Verlassen dieses Korbs (unabhängig
  // von der Rechnungsprüfung/4-Häkchen auf der Rechnung selbst) — zwei
  // UNTERSCHIEDLICHE Mitarbeiter müssen den Korb-Wechsel freigeben, bevor er
  // ausgeführt wird. Serverseitig erzwungen: bei kind IN (INBOX, HANDOVER)
  // immer false, nicht änderbar.
  fourEyesEnabled   Boolean @default(false)
  // Sammel-Benachrichtigung statt einer Mail pro Rechnung: läuft im
  // Scheduler (lib/baskets.ts runDueBasketNotifications, wie backup/report)
  // und schickt je fälligem Intervall EINE Übersichtsmail pro zugeordnetem
  // Mitarbeiter mit den aktuell im Korb liegenden Rechnungen.
  notificationEnabled       Boolean   @default(false)
  notificationIntervalHours Int?      // frei wählbares Intervall in Stunden
  lastNotifiedAt            DateTime?
  // Weiches Löschen (Stefan 2026-07-08): nur leere eigene Körbe löschbar (siehe
  // DELETE-Route), landen dann im "Papierkorb für Körbe" und lassen sich
  // wiederherstellen — analog zum Rechnungs-Papierkorb.
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   BasketMember[]
  invoices  Invoice[]
  approvals BasketApproval[]
  userRights BasketUserRight[]
  // Gruppen-Rechte (Stefan 2026-08-26) — siehe BasketGroupRight unten.
  groupRights BasketGroupRight[]
  transitionsFrom BasketTransition[] @relation("TransitionFrom")
  transitionsTo   BasketTransition[] @relation("TransitionTo")

  @@index([tenantId, kind])
}

// Belegfluss (Stefan 2026-08-25): erlaubte Verschiebe-Richtungen zwischen
// Körben, je Korb OPT-IN — solange für einen Korb (als Quelle) KEIN
// Eintrag existiert, darf weiterhin uneingeschränkt verschoben werden (wie
// bisher, kein Bruch für bestehende Mandanten). Sobald mindestens ein
// Eintrag mit fromBasketId = dieser Korb existiert, ist das Verschieben AUS
// diesem Korb auf genau die eingetragenen Ziele beschränkt (siehe
// lib/baskets.ts requestMove). "Beide Richtungen" ergibt sich einfach aus
// zwei Einträgen (A→B und B→A), kein eigenes Richtungs-Feld nötig.
model BasketTransition {
  id           String   @id @default(cuid())
  tenantId     String
  fromBasketId String
  toBasketId   String
  fromBasket   Basket   @relation("TransitionFrom", fields: [fromBasketId], references: [id], onDelete: Cascade)
  toBasket     Basket   @relation("TransitionTo", fields: [toBasketId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([fromBasketId, toBasketId])
  @@index([tenantId])
}

// ── Korb-Rechte je Rolle (Stefan 2026-07-08) ── Nur der Mandanten-Admin
// (und der Betreiber, der immer alle Rechte hat) kann diese Zuordnung in der
// Körbe-Verwaltung ändern. Für Rollen ohne Eintrag gilt: KEIN Zugriff auf
// diesen Korb (auch nicht "sehen"). Sechsstufige Rangfolge, jede Stufe
// schließt alle darunter liegenden ein (siehe lib/basketRights.ts RIGHT_RANK):
// sehen < Inhalt anzeigen < verschieben < sachlich freigeben <
// Übergabe an den Übergabekorb < Übergabe an die Fibu.
enum BasketRight {
  VIEW     // Korb wird überhaupt angezeigt
  CONTENT  // Rechnungsinhalt im Korb einsehen
  MOVE     // Rechnungen in/aus diesem Korb verschieben
  APPROVE  // "Sachlich richtig" auf Rechnungen in diesem Korb freigeben
  HANDOVER // Übergabe einer Rechnung an den (festen) Übergabekorb
  FIBU     // Übergabe an die Fibu auslösen (DATEV-Export/Einzel-Mail)
}

// Stefan 2026-07-08: ursprünglich rollenbasiert (BasketRolePermission) — auf
// Wunsch von Stefan direkt auf Mitarbeiter-Auswahl umgestellt, da die
// Rollen-Zuordnung in der Praxis nur verwirrt hat. Jede Zeile = ein
// Mitarbeiter mit einem Recht auf einem Korb; ohne Zeile = kein Zugriff.
model BasketUserRight {
  id        String      @id @default(cuid())
  basketId  String
  basket    Basket      @relation(fields: [basketId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  right     BasketRight
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([basketId, userId])
}

// Mitarbeiter-Gruppen (Stefan 2026-08-26): statt Korb-Rechte immer einzeln
// pro Mitarbeiter zu vergeben, lassen sich Mitarbeiter zu einer Gruppe
// zusammenfassen (z. B. "Einkauf", "Buchhaltung") und die Gruppe bekommt EIN
// Recht auf einen Korb — gilt dann für alle Mitglieder. Ergänzt die
// bestehende Einzel-Zuweisung (BasketUserRight), ersetzt sie nicht: die
// wirksame Berechtigung eines Mitarbeiters ist das höhere der beiden Rechte
// (siehe lib/basketRights.ts getBasketRightMap/hasBasketRight).
model EmployeeGroup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members      EmployeeGroupMember[]
  basketRights BasketGroupRight[]

  @@unique([tenantId, name])
}

model EmployeeGroupMember {
  id        String        @id @default(cuid())
  groupId   String
  group     EmployeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([groupId, userId])
}

model BasketGroupRight {
  id        String        @id @default(cuid())
  basketId  String
  basket    Basket        @relation(fields: [basketId], references: [id], onDelete: Cascade)
  groupId   String
  group     EmployeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  right     BasketRight
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([basketId, groupId])
}

// Mitarbeiter-Zuordnung zu einem Korb (wer ist zuständig / wird benachrichtigt)
model BasketMember {
  id        String   @id @default(cuid())
  basketId  String
  basket    Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([basketId, userId])
}

// Vier-Augen-Freigaben für einen konkreten Korb-Wechsel (Rechnung X, von Korb
// A nach Korb B). Bei der zweiten Freigabe eines ANDEREN Mitarbeiters für
// dieselbe Kombination wird der Wechsel automatisch ausgeführt und alle
// offenen Freigaben für diese Rechnung/diesen Ausgangskorb gelöscht
// (siehe lib/baskets.ts approveMove).
model BasketApproval {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fromBasketId   String
  fromBasket     Basket   @relation(fields: [fromBasketId], references: [id], onDelete: Cascade)
  targetBasketId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([invoiceId, fromBasketId, targetBasketId, userId])
}

// ── Einmal-Tickets für Identitätsübernahme (§12) ──
model LoginTicket {
  id               String    @id @default(cuid())
  code             String    @unique
  targetUserId     String
  impersonatorId   String?
  impersonatorName String?
  expiresAt        DateTime
  usedAt           DateTime?
}

// ── Handy-als-Kamera-Kopplung (Stefan 2026-08-27, "3D-Barcode/QR + kleine
// App fürs Handy") ──
// Der PC zeigt einen QR-Code mit dieser Sitzung; das Handy scannt ihn und
// lädt darüber Fotos hoch, die der PC live in seine laufende Scan-Seite
// übernimmt — ohne dass sich das Handy einloggen muss. Bewusst NICHT über
// LoginTicket gelöst: das würde eine volle Anmeldung verschaffen, hier soll
// der Token nur "Fotos in genau diese eine Sitzung hochladen" erlauben,
// sonst nichts.
// WICHTIG bei aktiver Beleg-Verschlüsselung: der Token/diese Zeile
// transportiert NIEMALS den echten DEK. Der PC erzeugt pro Sitzung einen
// eigenen, zufälligen Einmal-Schlüssel (ohne Bezug zum DEK) und gibt ihn nur
// im URL-Fragment (#k=…) des QR-Codes ans Handy weiter — Fragmente werden
// nie an den Server geschickt, der Server sieht also nie den Schlüssel und
// die hochgeladenen Fotos nie im Klartext (siehe api/scan-sessions/*).
model ScanSession {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User               @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  token           String             @unique
  createdAt       DateTime           @default(now())
  expiresAt       DateTime
  closedAt        DateTime?
  photos          ScanSessionPhoto[]

  @@index([tenantId])
}

// Einzelnes vom Handy hochgeladenes Foto einer ScanSession — liegt nur kurz
// als Datei (siehe lib/storage.ts, saveScanSessionPhoto), nicht als
// Invoice-Anhang: der PC lädt jedes Foto herunter, entschlüsselt es bei
// Bedarf lokal und übernimmt es in seine normale Seiten-Liste; erst beim
// finalen "Rechnung speichern" entsteht daraus ein echter Beleg.
model ScanSessionPhoto {
  id        String      @id @default(cuid())
  sessionId String
  session   ScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  // true = Datei-Inhalt ist mit dem Sitzungs-Einmal-Schlüssel verschlüsselt
  // (siehe Modell-Kommentar oben) — mimeType bleibt dabei bewusst im
  // Klartext gespeichert, exakt wie encOrigMime bei verschlüsselten
  // Rechnungs-Anhängen (kein neues Präzedenzfall).
  encrypted Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// ── Rechnung (E-Invoice Kernentität, mandantengetrennt) ──
model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Eindeutige, lesbare Dokumenten-ID (<Slug>-<laufende Nummer>, z. B.
  // "musterfirma-000001") — für GoBD-Referenzierung außerhalb der internen
  // cuid. Nullable für Bestandsdaten vor Einführung dieses Felds (Backfill
  // per scripts/backfill-doc-ids.ts), danach immer gesetzt.
  docId         String?       @unique
  // Körbe (Rechnungseingangsverarbeitung): aktueller Korb, in dem die
  // Rechnung liegt. Nullable für Bestand vor Einführung — Backfill setzt
  // den Eingangskorb (siehe scripts/backfill-baskets.ts).
  basketId      String?
  basket        Basket?       @relation(fields: [basketId], references: [id], onDelete: SetNull)
  basketApprovals BasketApproval[]
  vendor        String
  invoiceNumber String?
  invoiceDate   DateTime?
  dueDate       DateTime?
  // Skonto (Stefan 2026-08-25) — separate, kürzere Frist für vorzeitige
  // Zahlung mit Rabatt, getrennt von dueDate (immer das eigentliche
  // Zahlungsziel netto). Aus KI-Erkennung (lib/aiExtract.ts) oder bei
  // XRechnung-CII/ZUGFeRD strukturiert aus dem XML (lib/erechnung.ts) —
  // vorher wurde diese Unterscheidung gar nicht getroffen.
  discountDueDate DateTime?
  discountPercent Decimal?      @db.Decimal(5, 2)
  // Anschrift/Steuerkennung des Lieferanten (Stefan 2026-08-25) — bei
  // E-Rechnung (ZUGFeRD/XRechnung) steht das strukturiert im XML (siehe
  // lib/erechnung.ts ParsedInvoiceData), bei PDF/KI/manuell erfasster
  // Rechnung gab es dafür bisher gar kein Feld, obwohl §14 Abs. 4 Nr. 1+2
  // UStG beides zwingend vorschreibt — jetzt per KI-Bestenfalls-Erkennung
  // (lib/aiExtract.ts) oder von Hand nachtragbar (siehe ERechnungView.tsx
  // Eingabe-Modus, nur bei Nicht-E-Rechnung sichtbar).
  sellerAddress   String?
  sellerVatId     String?
  sellerTaxNumber String?
  // Land des Lieferanten (Stefan 2026-08-25, ISO 3166-1 alpha-2) — nur bei
  // Nicht-E-Rechnung gespeichert (KI-Bestenfalls-Erkennung), bei E-Rechnung
  // wird es live aus dem XML gelesen (lib/erechnung.ts). Grundlage für die
  // Inland/EU/Drittland-Einordnung unten.
  sellerCountryCode String?
  // Inland/EU/Drittland (Stefan 2026-08-25, lib/erechnung.ts classifyTaxRegion)
  // — bleibt NULL solange automatisch aus sellerCountryCode abgeleitet wird;
  // wird nur gesetzt, wenn ein Mensch die automatische Einordnung manuell
  // überschreibt (z. B. bei Sonderfällen, die die einfache Länder-Zuordnung
  // nicht abbildet). Bestimmt, welche Pflichtangaben-Regel bei der
  // Vollständigkeitsprüfung gilt.
  taxRegion String?
  // "Prüfung ignorieren" (Stefan 2026-08-25) — bewusste, begründungspflichtige
  // Ausnahme von der Pflichtangaben-Vollständigkeitsprüfung (z. B. wenn eine
  // Angabe nachweislich nicht zutrifft/nicht erhältlich ist). Nur Anzeige
  // betroffen, keine Sperre wird dadurch aufgehoben — GoBD-Nachvollziehbarkeit
  // über Grund/wer/wann sichergestellt.
  pflichtangabenIgnoredAt     DateTime?
  pflichtangabenIgnoredBy     String?
  pflichtangabenIgnoredReason String?
  amountNet     Decimal?      @db.Decimal(12, 2)
  amountTax     Decimal?      @db.Decimal(12, 2)
  amountGross   Decimal?      @db.Decimal(12, 2)
  currency      String        @default("EUR")
  status        InvoiceStatus @default(NEW)
  tags          String?
  notes         String?
  // Volltextsuche für UNVERSCHLÜSSELTE Mandanten (Stefan 2026-08-27, "eine
  // Volltextsuche kann ich mit der Verschlüsselung vergessen oder?") — von
  // PostgreSQL selbst aus vendor/invoiceNumber/tags/notes/mailBodyText
  // generierte, automatisch aktuell gehaltene tsvector-Spalte (GENERATED
  // ALWAYS AS ... STORED, siehe Migration 20260827180000_fulltext_search —
  // Prisma kennt den Typ "tsvector" nicht nativ, daher Unsupported; der GIN-
  // Index darauf ist rein in der Migration definiert, nicht hier abbildbar).
  // Bei verschlüsselten Mandanten bleibt sie leer (Inhalt ist Chiffrat) —
  // dafür gibt es stattdessen den Blind-Index unten (InvoiceSearchToken).
  searchVector  Unsupported("tsvector")?
  fileName      String? // gespeicherter Dateiname unter uploads/{tenantId}/
  originalName  String?
  mimeType      String?
  encrypted     Boolean @default(false) // Datei liegt als Chiffrat (IV + AES-GCM)
  encOrigMime   String? // ursprünglicher MIME-Typ (für Anzeige nach Entschlüsselung)
  // Inhalts-Verschlüsselung (Stefan 2026-07-09): bei aktiver Mandanten-
  // Verschlüsselung wird NICHT mehr nur die Beleg-Datei, sondern auch der
  // inhaltliche Teil der Rechnungsdaten client-seitig verschlüsselt — Server
  // sieht auch hier nur Chiffrat. contentEnc enthält ein einziges AES-GCM-
  // Chiffrat (Base64, IV+Ciphertext, wie bei der Datei) eines JSON-Objekts
  // mit { vendor, invoiceNumber, amountNet, amountTax, amountGross, currency,
  // tags, notes, xmlData }. Die gleichnamigen Einzelspalten bleiben bei
  // verschlüsselten Rechnungen leer/Platzhalter (vendor bekommt einen festen
  // Platzhalter-Text statt NULL, da NOT NULL) — NICHT der wahre Inhalt.
  // Workflow-Felder (dueDate, status, checkXxxAt/By, directDebitByVendor)
  // bleiben bewusst im Klartext, damit Fälligkeits-Erinnerungen, Körbe-Zähler
  // und die Rechnungsprüfung serverseitig weiter funktionieren. Suche/
  // Sortierung nach Lieferant/Beträgen sowie der DATEV-Export müssen für
  // verschlüsselte Mandanten client-seitig laufen (Folgearbeit, siehe Task
  // #101/#102) — hier wird zunächst nur das Datenmodell dafür vorbereitet.
  contentEnc    String?
  // Kostenstellen/Kostenträger (Stefan 2026-07-09, #114): optionale
  // Buchungsdimension, nur nutzbar wenn Tenant.costCentersEnabled — als
  // freier Code-String statt Fremdschlüssel gespeichert (siehe CostCode-
  // Kommentar oben, GoBD-Grund). Workflow-Feld, bleibt IMMER im Klartext,
  // auch bei aktiver Inhalts-Verschlüsselung (wie dueDate/status).
  costCenterCode  String?
  costCarrierCode String?
  // Dubletten-Prüfung: Datei-Hash + Verweis auf das erkannte Original
  fileHash      String? // SHA-256 der Beleg-Datei
  duplicateOfId String? // gesetzt = als Dublette erkannt
  // KI-Datenerkennung: true = mindestens ein Feld wurde per KI übernommen
  // (Erstauswahl beim Scannen, nachträglich auf der Detailseite, oder
  // automatisch beim Mail-Eingang für "nackte" PDFs ohne ZUGFeRD/XRechnung-XML)
  // — sichtbar in der Rechnungsliste (source + aiAssisted zeigen dort
  // Herkunft/Erfassungsart). aiConfirmedAt/-By: menschliche Bestätigung der
  // KI-Werte (Tab-Bestätigungs-Flow im Formular) — solange leer, ist die
  // Rechnung noch NICHT verschiebbar (siehe lib/baskets.ts requestMove) und
  // erscheint in der Liste andersfarbig markiert. aiUncertainFields: von der
  // KI selbst/durch Plausibilitätsprüfung als unsicher markierte Feldnamen,
  // kommagetrennt (für die Warn-Hervorhebung im Formular nach automatischer
  // Erkennung — bei einer LIVE-Erkennung im Browser kommt das direkt von der
  // API-Antwort, hier persistiert für den Fall ohne offene Browser-Sitzung).
  aiAssisted        Boolean @default(false)
  aiConfirmedAt     DateTime?
  aiConfirmedBy     String?
  aiUncertainFields String?
  // Spam-/Nicht-Rechnung-Klassifikation beim Mail-Eingang (Stefan 2026-08-25,
  // lib/mailin.ts): INVOICE (vertrauenswürdig — strukturierte E-Rechnung ODER
  // KI erkennt eindeutig Rechnung mit Kernfeldern), UNCERTAIN (KI/Heuristik
  // nicht eindeutig — bleibt im Eingangskorb, ggf. zusätzlich per aiAssisted/
  // aiConfirmedAt blockiert bis geprüft) oder NOT_INVOICE (KI erkennt
  // eindeutig KEINE Rechnung — landet automatisch im Spam-Verdacht-Korb statt
  // im Eingangskorb, siehe BasketKind.QUARANTINE). Null = nicht klassifiziert
  // (Scan/manueller Upload/Bestand vor Einführung — dort hat ein Mensch die
  // Auswahl schon bewusst getroffen, keine Klassifikation nötig).
  invoiceClass      String?
  // Sicherheit der obigen Einstufung in Prozent (Stefan 2026-08-25, 0-100) —
  // von der KI selbst geschätzt (aiExtract.ts notInvoiceConfidence) oder bei
  // der Stichwort-Rückfallebene grob aus der Regel abgeleitet (mailin.ts).
  // Null = keine Einstufung (siehe invoiceClass oben).
  invoiceClassConfidence Int?
  // Beleg-PDF wurde serverseitig aus dem HTML-Mailtext gerendert, ist also
  // KEIN vom Lieferanten mitgeschicktes Original-PDF (Stefan 2026-08-25,
  // HTML-Auslandsrechnung ohne Anhang — siehe lib/htmlToPdf.ts). Anzeige als
  // eigenes Kennzeichen in der "Inhalt"-Spalte (InvoiceRows.tsx), damit klar
  // ist: das ist eine Rekonstruktion, kein Original.
  htmlRendered      Boolean @default(false)
  // Mailtext, der zusammen mit dem Beleg ankam (Stefan 2026-08-25) — bei
  // HTML-Auslandsrechnungen identisch mit dem Belegtext, bei Anhängen
  // zusätzlicher Begleittext, der sonst verloren ginge (z. B. "diese
  // Rechnung ersetzt die vorherige"). Nur beim Mail-Eingang gesetzt, auf
  // 5000 Zeichen gedeckelt (siehe lib/mailin.ts).
  mailBodyText      String?
  // Graph-Nachrichten-ID der Quell-Mail (Stefan 2026-08-25) — analog
  // MailIntake.sourceMessageId oben, aber HIER auf der Rechnung selbst, damit
  // mehrere Rechnungen aus derselben Sammel-Mail (mehrere PDF-Anhänge, je
  // eine eigene Rechnung, siehe lib/mailin.ts processInboundAttachments)
  // gegenseitig verlinkt werden können ("weitere Rechnungen aus dieser
  // E-Mail" auf der Detailseite) — sonst sieht man nach dem automatischen
  // Aufteilen in einzelne Vorgänge nicht mehr, dass sie zusammengehören.
  // Nur bei Graph-Mail-Eingang gesetzt (SMTP hat keine stabile Message-ID).
  sourceMessageId   String?
  // Absenderadresse der Quell-Mail (Stefan 2026-08-25, nur bei source=EMAIL
  // gesetzt) — stabilerer Lieferanten-Schlüssel als der oft leicht
  // unterschiedlich geschriebene Firmenname aus der KI-/XML-Erkennung.
  // Grundlage für das Lieferanten-Gedächtnis (siehe lib/vendorMemory.ts):
  // einmal von einem Menschen bestätigte Angaben desselben Absenders werden
  // bei der nächsten Rechnung als Vorschlag/KI-Referenz wiederverwendet.
  senderEmail       String?
  // Rechnungsversionierung (Stefan 2026-08-25, Tenant.autoSupersedeInvoiceVersions)
  // — gesetzt, wenn eine NEUERE Version derselben Rechnung (gleiche
  // Rechnungsnummer + Lieferant, anderer Dateiinhalt) eingegangen ist. Macht
  // diese Rechnung schreibgeschützt (wie ein abgeschlossener Prüfungszeitraum,
  // siehe isInvoiceLockedByClosure) — bleibt aber vollständig einsehbar,
  // nichts wird gelöscht.
  supersededAt           DateTime?
  supersededByInvoiceId  String?
  // Automatische Spam-Antwort bereits verschickt (Stefan 2026-08-25, Tenant.spamReplyEnabled) —
  // verhindert Mehrfachversand bei erneuter Verarbeitung/Reklassifikation.
  spamReplySentAt DateTime?
  // Positionszeilen aus der KI-Erkennung (Stefan 2026-08-25, lib/aiExtract.ts):
  // nur bei nackten PDFs/Scans OHNE strukturiertes XML gesetzt — für
  // ZUGFeRD/XRechnung werden die Positionen stattdessen live aus xmlData
  // gelesen (siehe ERechnungView.tsx), keine Duplizierung nötig. JSON-Array
  // aus {name, qty, unitPrice, total}, null wenn (noch) keine KI-Erkennung
  // gelaufen ist oder keine Positionen erkennbar waren.
  lineItems Json?
  // Warnung "Rechnungsempfänger weicht von der Firmenbezeichnung ab" wurde
  // vom Nutzer bewusst akzeptiert (Stefan 2026-08-25, Tenant.legalName) —
  // analog zum bestehenden Dubletten-"keine Dublette"-Muster: die Warnung
  // bleibt sichtbar (Beweiswert), verschwindet aber aus dem aktiven Zustand.
  buyerNameMismatchAcknowledged Boolean @default(false)
  // E-Rechnung (W17): erkanntes Format + Prüfergebnis + XML für die Visualisierung
  docFormat        String? // ZUGFERD | XRECHNUNG_CII | XRECHNUNG_UBL | PDF | OTHER
  xmlData          String? // eingebettetes/originales Rechnungs-XML
  validationOk     Boolean? // Pflichtfeld-Prüfung (EN 16931-Kern) bestanden?
  validationIssues String? // fehlende Pflichtangaben (kommagetrennt)
  // Offizielle KoSIT-Prüfung (Stefan 2026-08-26, lib/kositValidator.ts) —
  // läuft automatisch im Hintergrund direkt nach Ablage jeder E-Rechnung mit
  // xmlData, zusätzlich jederzeit manuell im Prüfbericht erneut auslösbar.
  // kositCheckedAt null = noch nicht geprüft (z. B. keine E-Rechnung oder
  // Validator zum Ablagezeitpunkt nicht installiert) — KEIN Fehlerzustand.
  kositCheckedAt DateTime?
  kositAccepted  Boolean? // null = Bericht ohne eindeutiges Verdict (selten)
  kositScenario  String?
  kositMessages  Json?
  // Rechnungsprüfung (klassischer 4-Augen-Workflow): je Schritt wer + wann
  // geprüft hat — gesetzt = erledigt, null = offen. Vom Server gestempelt
  // (angemeldeter Nutzer), nicht vom Client frei setzbar.
  checkElectronicAt  DateTime? // Elektronische Vorprüfung
  checkElectronicBy  String?
  checkFormalAt      DateTime? // Formal richtig
  checkFormalBy      String?
  checkSubstantiveAt DateTime? // Sachlich richtig
  checkSubstantiveBy String?
  checkAccountingAt  DateTime? // An Buchhaltung übergeben
  checkAccountingBy  String?
  // Zahlungsart: Lieferant zieht den Betrag selbst per Lastschrift/Abbuchung
  // ein (statt Überweisung durch uns)
  directDebitByVendor Boolean @default(false)
  source        String        @default("UPLOAD")
  // "Löschen" markiert nur — echtes Entfernen widerspräche der revisionssicheren
  // Nachvollziehbarkeit (GoBD). Gelöschte Rechnungen verschwinden aus der
  // normalen Liste, bleiben aber (inkl. Beleg-Datei) erhalten und lassen sich
  // wiederherstellen.
  deletedAt     DateTime?
  deletedBy     String?
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  attachments   InvoiceAttachment[]
  messages      InvoiceNote[]
  searchTokens  InvoiceSearchToken[]

  @@index([tenantId, status])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, fileHash])
  @@index([tenantId, deletedAt])
  @@index([tenantId, sourceMessageId])
  @@index([tenantId, senderEmail])
  @@index([basketId])
}

// Blind-Index für die Suche bei VERSCHLÜSSELTEN Mandanten (Stefan 2026-08-27)
// — echte Volltextsuche geht dort nicht (Server sieht nur Chiffrat, siehe
// Invoice.contentEnc). Stattdessen bildet der Browser beim Speichern für
// Lieferant + Rechnungsnummer je (normalisiertes) Wort einen deterministischen
// HMAC-SHA256 mit einem vom Datenschlüssel (DEK) abgeleiteten Such-Schlüssel
// (siehe lib/clientCrypto.ts deriveSearchKey/computeSearchTokens) und schickt
// NUR diese Hashes mit — nie den Klartext. Beim Suchen bildet der Browser
// denselben Hash aus dem Suchbegriff und schickt NUR den ab; der Server
// vergleicht Hash gegen Hash.
// WICHTIG — bewusster Kompromiss, kein Nebenwirkungsloses Feature: der Hash
// ist zwangsläufig deterministisch (gleicher Klartext → gleicher Hash), sonst
// funktioniert kein Abgleich. Wer Zugriff auf diese Tabelle hat (Betreiber,
// DB-Zugriff), kann dadurch erkennen, dass zwei Rechnungen denselben
// Lieferantennamen/dieselbe Rechnungsnummer haben — OHNE den Klartext selbst
// zu kennen. Das ist eine Abschwächung des sonst absoluten "niemand außer dem
// Mandanten kann irgendetwas lesen"-Versprechens (siehe EncryptionSetup.tsx-
// Warnhinweis) und wurde dem Kunden so auch erklärt (Stefan, 2026-08-27).
model InvoiceSearchToken {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  token     String // Hex-HMAC, keine sinnvolle Länge zum Erraten des Klartexts

  @@index([tenantId, token])
  @@index([invoiceId])
}

// ── Zusätzliche Dokumente zu einer Rechnung (Stefan 2026-07-08): neben dem
// eigentlichen Beleg lassen sich jederzeit weitere Dateien anhängen (z. B.
// Lieferschein, Vertrag, Mail-Verlauf, Bestellung) — unabhängig vom
// Haupt-Beleg und dessen GoBD-Sperre bei E-Rechnungen (Anhänge sind reine
// Zusatzinformation, keine Rechnungsdaten, daher jederzeit hinzufügbar/
// löschbar, auch bei ZUGFeRD/XRechnung). Nutzt denselben Datei-Speicher wie
// der Hauptbeleg (lib/storage.ts), aber OHNE Zero-Knowledge-Verschlüsselung
// (v1) — bei aktiver Beleg-Verschlüsselung des Mandanten wird der Upload
// serverseitig gesperrt, um keine unverschlüsselten sensiblen Anhänge neben
// verschlüsselten Belegen abzulegen.
model InvoiceAttachment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId     String
  fileName     String // gespeicherter Dateiname unter uploads/{tenantId}/
  originalName String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([invoiceId])
}

// ── Gerichtete Nachricht an einen Mitarbeiter (Stefan 2026-07-08): anders
// als das freie Notizfeld (Invoice.notes, z. B. Kontierung) ist dies eine
// ADRESSIERTE Nachricht an einen bestimmten Kollegen — z. B. "bitte
// Kostenstelle prüfen, betrifft Projekt X" — wichtig für dessen nächsten
// Bearbeitungsschritt. Mehrere Nachrichten pro Rechnung möglich (kleiner
// Verlauf statt Überschreiben), mit Lese-Status.
model InvoiceNote {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId  String
  authorId  String?
  author    User?     @relation("InvoiceNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  toUserId  String?
  toUser    User?     @relation("InvoiceNoteRecipient", fields: [toUserId], references: [id], onDelete: SetNull)
  // Betreff (Stefan 2026-08-26, "sollte schon etwas mehr können") — optional,
  // für den schnellen Überblick ohne den ganzen Text lesen zu müssen.
  subject   String?
  text      String
  readAt    DateTime?
  // "Erledigt"-Haken (Stefan 2026-08-26) — eigenständig von readAt: eine
  // Nachricht kann gelesen, aber noch nicht abgearbeitet sein. Wer sie
  // erledigt hat, bleibt nachvollziehbar (doneBy). Bei isHandoff=true (siehe
  // unten) bedeutet dieses Feld stattdessen "zurückgegeben" — nur der
  // Empfänger (toUserId) darf es setzen, siehe api/invoices/[id]/notes/[noteId]/route.ts.
  doneAt    DateTime?
  doneBy    String?
  createdAt DateTime  @default(now())
  // "Zur Prüfung weitergeben" (Stefan 2026-08-27) — anders als eine normale
  // adressierte Nachricht SPERRT ein aktiver Handoff (isHandoff=true,
  // doneAt=null) die Rechnung für jeden außer dem Empfänger (toUserId) — der
  // "bearbeitet" sie jetzt, der Absender sieht sie nur noch schreibgeschützt
  // (siehe lib/invoiceHandoff.ts). toUserId ist bei isHandoff=true daher
  // PFLICHT (serverseitig erzwungen, siehe .../notes/route.ts POST) — anders
  // als bei einer normalen, optional adressierten Nachricht. Höchstens EIN
  // aktiver Handoff gleichzeitig je Rechnung; "zurückgeben" (Empfänger setzt
  // doneAt) beendet ihn wieder, die Rechnung wird für alle wieder normal
  // bearbeitbar. Nutzt bewusst dieselbe Sichtbarkeits-/Maskierungs- und
  // Erledigt-Logik wie normale Nachrichten wieder, statt eigener Tabelle.
  isHandoff Boolean   @default(false)

  @@index([invoiceId])
  @@index([toUserId, readAt])
  @@index([invoiceId, isHandoff, doneAt])
}
