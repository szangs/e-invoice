# E-Rechnung-Check-Dienst — Konfiguration
# Diese Datei nach .env kopieren.

# HTTP-Bindung (hinter dem Reverse-Proxy nur lokal):
HOST=127.0.0.1
PORT=8787

# Domains, die die API im Browser aufrufen dürfen. Komma-getrennt.
# Bei All-in-one (Seite + Dienst auf dem vServer) reicht die e-rechnung-Domain.
ALLOWED_ORIGINS=https://e-rechnung.deltaplus.de,https://www.deltaplus.de,https://deltaplus.de

# Maximale Uploadgröße in Bytes (Default 15 MB)
MAX_BYTES=15728640

# ── Missbrauchsschutz ──
# Origin/Referer-Pflicht: nur Aufrufe von ALLOWED_ORIGINS zulassen (Default an).
# Zum lokalen Testen ohne Website ggf. auf false setzen.
REQUIRE_ORIGIN=true
# nginx setzt X-Forwarded-For — daher der echten Client-IP vertrauen:
TRUST_PROXY=true
# Rate-Limit je IP:
RATE_MAX=15
RATE_WINDOW_MS=600000
# Höchstzahl gleichzeitig laufender KoSIT-Prüfungen (CPU-Schutz):
MAX_CONCURRENT=3
# Cloudflare Turnstile (optional): Secret hier, passenden Sitekey in
# public/index.html (<meta name="e-rechnung-turnstile-sitekey">). Leer = aus.
# TURNSTILE_SECRET=
# Statisches API-Token (optional, schwacher Zusatzfilter): Header X-Api-Token.
# Muss dann auch in public/index.html (<meta name="e-rechnung-api-token">) stehen.
# API_TOKEN=

# ── KoSIT-Validator ──
# Wird von "npm run setup:kosit" automatisch gesetzt:
# KOSIT_VALIDATOR_JAR=/opt/e-rechnung-check/service/kosit/validator/validationtool-1.5.0-standalone.jar
# KOSIT_SCENARIOS=/opt/e-rechnung-check/service/kosit/configuration/scenarios.xml

# Java-Aufruf (falls "java" nicht im PATH):
# JAVA_BIN=/usr/lib/jvm/java-17-openjdk-amd64/bin/java

# Zeitlimit je Prüfung in ms (Default 120000)
KOSIT_TIMEOUT_MS=120000

# JVM-Heap-Limit für den Validator (kleiner vServer → Default 512m)
KOSIT_JAVA_XMX=512m
